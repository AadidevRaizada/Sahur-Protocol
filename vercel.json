{
  "version": 2,
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/(.*\\.mp3)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/Sahur_Protocol.html"
    }
  ],
  "redirects": [
    {
      "source": "/presentation",
      "destination": "/gamedesign/pitch/Sahur_Protocol_Pitch",
      "permanent": false
    },
    {
      "source": "/presentation/",
      "destination": "/gamedesign/pitch/Sahur_Protocol_Pitch",
      "permanent": false
    }
  ]
}
